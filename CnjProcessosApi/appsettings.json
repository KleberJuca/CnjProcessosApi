{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=processos.db"
  },
  "DataJud": {
    "BaseUrl": "https://api-publica.datajud.cnj.jus.br/",
    "ApiKey": "",
    "CacheMinutes": 60
  },
  "RateLimiting": {
    "PermitLimitPerMinute": 120
  },
  "Quartz": {
    "SyncIntervalCron": "0 0 0 * * ?"
  },
  "Processos": {
    "NumerosCNJ": [],
    "EnableManualSync": false
  },
  "Legal": {
    "NonCommercialOnly": true,
    "TermsOfUseUrl": "https://datajud-wiki.cnj.jus.br/api-publica/termo-uso/",
    "Disclaimer": "Dados do DataJud 'as is'. Uso gratuito e não comercial conforme termos do CNJ."
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "HttpsRedirection": {
    "Enabled": false
  }
}