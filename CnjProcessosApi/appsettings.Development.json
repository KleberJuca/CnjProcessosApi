{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/dev-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=processos.dev.db"
  },
  "DataJud": {
    "BaseUrl": "https://api-publica.datajud.cnj.jus.br/",
    "ApiKey": "",
    "CacheMinutes": 60
  },
  "Quartz": {
    "SyncIntervalCron": "0 0 */4 * * ?"
  },
  "Processos": {
    "NumerosCNJ": [],
    "EnableManualSync": false
  },
  "AllowedHosts": "*"
}