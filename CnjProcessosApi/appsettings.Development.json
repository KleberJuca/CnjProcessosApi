{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "Logs/dev-log-.txt", "rollingInterval": "Day" } }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=processos.dev.db"
  },
  "DataJud": {
    "BaseUrl": "https://api-publica.datajud.cnj.jus.br/",
    "ApiKey": "DEV_CHANGE_ME_API_KEY",
    "TribunalEndpoint": "api_publica_tjsp/_search"
  },
  "Jwt": {
    "Issuer": "CnjProcessosApi",
    "Audience": "CnjProcessosApi",
    "Secret": "DEV_CHANGE_ME_SUPER_SECRET_KEY_32_CHARS_MIN"
  },
  "Quartz": {
    "SyncIntervalCron": "0 0 */4 * * ?"
  },
  "Processos": {
    "NumerosCNJ": [
      "0000000-00.0000.0.00.0000",
      "1111111-11.1111.1.11.1111"
    ]
  },
  "AllowedHosts": "*"
}
