@page
@model CnjProcessosApi.Pages.IndexModel
@{
    ViewData["Title"] = "Consulta Pública de Processos";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: radial-gradient(circle at 20% 0%, #e6f2fb 0, #f7fbff 50%, #f2f6fa 100%);
        }
        .glass-panel {
            backdrop-filter: blur(6px);
            background: rgba(255, 255, 255, 0.85);
            border-radius: 12px;
            box-shadow: 0 1rem 1.5rem rgba(0,0,0,.08);
            border: 1px solid rgba(0,0,0,.06);
        }
        .brand {
            font-weight: 700;
            letter-spacing: .5px;
        }
        .title {
            font-family: Georgia, "Times New Roman", serif;
            font-weight: 700;
        }
        .input-group .form-control { height: 3rem; }
        .btn-search { height: 3rem; }
        .badge-info-icon {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 50%;
            background: #0d6efd; color: #fff; font-weight: 700;
        }
        .cnj-logo {
            max-height: 80px;
            opacity: .9;
        }
        footer { font-size: .9rem; color: #6c757d; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light" style="background:#0d6efd;">
        <div class="container">
            <a class="navbar-brand text-white brand" href="/">CnjProcessos API Pública</a>
            <span class="navbar-text text-white-50">Consulta cidadã</span>
        </div>
    </nav>

    <main class="container py-4">
        <div class="glass-panel p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="title h2 mb-0">Consulta Pública de Processos</h1>
                <img class="cnj-logo" src="/images/logo.png" alt="CNJ" />
            </div>

            <div class="alert alert-primary d-flex align-items-center" role="alert">
                <span class="badge-info-icon me-3">i</span>
                <div>Dados do DataJud 'as is'. Uso gratuito e não comercial conforme termos do CNJ.</div>
            </div>

            <form class="mt-3" method="get" action="/api/processos">
                <div class="mb-3">
                    <label for="numero" class="form-label fw-semibold">Número CNJ:</label>
                    <div class="input-group">
                        <input id="numero" name="filtro" type="text" class="form-control" placeholder="0000000-00.0000.0.00.0000"/>
                        <button type="submit" class="btn btn-primary btn-search">
                            <span class="me-2">&#128269;</span> Consultar
                        </button>
                    </div>
                    <div class="form-text">Informe um número CNJ completo para buscar.</div>
                </div>
            </form>

            <div class="text-center text-muted mt-4">
                Dados do DataJud 'as is'. Uso gratuito e não comercial conforme termos do CNJ.
            </div>
        </div>
    </main>

    <footer class="container py-4">
        <div class="d-flex justify-content-between">
            <span>© @DateTime.Now.Year CnjProcessos – Open Source (MIT)</span>
            <a class="link-secondary" href="https://datajud-wiki.cnj.jus.br/api-publica/termo-de-uso" target="_blank">Termo de Uso do CNJ</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
